{
  "name": "@cyh-minecraft/map-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Solid map rendering, bounded biome tiles, and inspection for squaremap integrations",
  "license": "MIT",
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "SOURCE_SNAPSHOT.json"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/map-ui.css"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "build": "vite build && tsc --project tsconfig.build.json",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "vite",
    "benchmark:browser": "playwright test --config=playwright.seed-benchmark.config.ts"
  },
  "peerDependencies": {
    "@solidjs/signals": "2.0.0-rc.8",
    "@solidjs/web": "2.0.0-rc.8",
    "solid-js": "2.0.0-rc.8",
    "leaflet": "1.9.4"
  },
  "devDependencies": {
    "@solidjs/babel-plugin": "2.0.0-rc.8",
    "@solidjs/compiler": "2.0.0-rc.8",
    "@solidjs/signals": "2.0.0-rc.8",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.43",
    "@solidjs/web": "2.0.0-rc.8",
    "@types/leaflet": "1.9.22",
    "jsdom": "30.1.0",
    "leaflet": "1.9.4",
    "solid-js": "2.0.0-rc.8",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.0",
    "vitest": "5.0.1",
    "@playwright/test": "1.63.0"
  },
  "overrides": {
    "@solidjs/babel-plugin": "$@solidjs/babel-plugin",
    "@solidjs/compiler": "$@solidjs/compiler",
    "@solidjs/signals": "$@solidjs/signals"
  }
}

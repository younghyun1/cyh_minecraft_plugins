{
  "name": "vite-template-solid",
  "version": "0.0.0",
  "description": "",
  "type": "module",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "vite build",
    "contracts:check": "cargo run --manifest-path ../Cargo.toml --locked --package rust-be-template --bin openapi-contracts -- check",
    "contracts:generate": "cargo run --manifest-path ../Cargo.toml --locked --package rust-be-template --bin openapi-contracts -- generate",
    "serve": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "NODE_OPTIONS=--no-experimental-webstorage vitest run",
    "test:watch": "NODE_OPTIONS=--no-experimental-webstorage vitest",
    "optimization:check": "tsc --noEmit --project tsconfig.optimization.json && eslint e2e/optimization playwright.optimization.config.ts vitest.optimization.config.ts --max-warnings 0 && vitest run --config vitest.optimization.config.ts",
    "test:e2e": "playwright test",
    "test:e2e:chromium": "playwright test --project=chromium",
    "test:e2e:performance": "playwright test --config=playwright.performance.config.ts",
    "test:e2e:security": "playwright test --config=playwright.security.config.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@solidjs/testing-library": "1.0.0-beta.3",
    "@solidjs/vite-plugin": "3.0.0-next.47",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@types/leaflet": "1.9.22",
    "@typescript/native": "npm:typescript@^7.0.2",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.12.0",
    "eslint-plugin-solid": "^0.18.1",
    "jsdom": "^30.1.2",
    "oxlint": "^1.87.0",
    "postcss": "^8.5.29",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/ibm-plex-sans-kr": "^5.3.0",
    "@solid-primitives/keyed": "3.0.0-next.2",
    "@solid-primitives/utils": "7.0.0-next.4",
    "@solidjs/router": "2.0.0-next.35",
    "@solidjs/web": "2.0.0-rc.13",
    "@toast-ui/editor": "^3.2.2",
    "chart.js": "^4.5.1",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.12.0",
    "leaflet": "1.9.4",
    "leaflet-geosearch": "^4.4.0",
    "marked": "^18.1.0",
    "solid-js": "2.0.0-rc.13",
    "turndown": "^7.2.4",
    "turndown-plugin-gfm": "^1.0.2"
  },
  "overrides": {
    "dompurify": "$dompurify",
    "@tailwindcss/typography": {
      "postcss-selector-parser": "7.1.6"
    }
  }
}
